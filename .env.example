# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Hugging Face API Token for accessing gated models (e.g., Atlas-Chat)
# Get yours from https://huggingface.co/settings/tokens
HUGGING_FACE_HUB_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database - Local PostgreSQL (primary, used by default via docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Supabase Database (fallback if local PG is unavailable)
# Find these in Supabase Dashboard > Settings > Database > Connection string
SUPABASE_DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
SUPABASE_DIRECT_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
