# ── Database ─────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/deutschdarija?schema=public"
# Direct (non-pooled) connection used by Prisma migrations. Locally it's the same database;
# with Supabase, point it at the direct connection string (port 5432, not the pooler).
DIRECT_URL="${DATABASE_URL}"
# Optional fallback database used when DATABASE_URL is unreachable at startup
# SUPABASE_DATABASE_URL="postgresql://..."

# ── Authentication ───────────────────────────────────────────────────
# JWT Secret - generate a secure random string (min 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-secure-jwt-secret-here"

# ── Server ───────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── AI Service ───────────────────────────────────────────────────────
# Which AI answers the AI teacher and generates tests:
#   openrouter (default) - free OpenRouter models, no GPU or Python service needed
#   rag                  - the Python RAG service with the local Atlas-Chat-9B model
#                          (falls back to OpenRouter if the service is down)
AI_PROVIDER=openrouter
# Free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: comma-separated models tried in order (default: a list of free models)
# OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,qwen/qwen3.8-27b:free,openrouter/free

# Python RAG service, used when AI_PROVIDER=rag
RAG_SERVICE_URL=http://localhost:8000

# Hugging Face API Token (for calling remote inference APIs or gated models)
# Get yours from https://huggingface.co/settings/tokens
HUGGING_FACE_HUB_TOKEN=hf_your_token_here

# ── Email (password reset) ───────────────────────────────────────────
# Without RESEND_API_KEY, reset links are printed to the server console in development.
# RESEND_API_KEY=re_your_key_here
# EMAIL_FROM="Deutsch B'Darija <no-reply@yourdomain.com>"

# ── Proxy ────────────────────────────────────────────────────────────
# Set when running behind a reverse proxy so client IPs and https URLs are correct
# TRUST_PROXY=1

# ── CORS ─────────────────────────────────────────────────────────────
# Frontend URL for CORS (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:3000

# ── Seed ─────────────────────────────────────────────────────────────
# Admin user password for seed script (default: admin123!)
ADMIN_PASSWORD=admin123!

# Shared secret for the RAG service (must equal RAG_API_KEY there)
# RAG_API_KEY=generate-a-long-random-string
