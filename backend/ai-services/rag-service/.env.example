# LLM provider: openrouter (default, free models) | local_atlas (needs CUDA GPU) | ollama
RAG_LLM_PROVIDER=openrouter
# Get a free key at https://openrouter.ai/keys
RAG_OPENROUTER_API_KEY=
# Optional: comma-separated models, tried in order
# RAG_OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,qwen/qwen3.8-27b:free,openrouter/free

# Atlas-Chat-9B on HuggingFace Space (primary — set this to enable)
RAG_HF_SPACE_ID=             # e.g. "your-username/atlas-chat-9b-darija"
HUGGING_FACE_HUB_TOKEN=      # Required if loading gated models or calling private spaces

# Ollama fallback (used when HF_SPACE_ID is empty)
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_OLLAMA_MODEL=deepseek-v3.1:671b-cloud

# Embeddings
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DEVICE=cpu     # "cuda" or "cpu"

# RAG
RAG_RETRIEVAL_TOP_K=5
RAG_CHUNK_SIZE=400
RAG_MIN_RELEVANCE_SCORE=0.3

# Generation
RAG_TEMPERATURE=0.7
RAG_MAX_NEW_TOKENS=800

# Server
RAG_HOST=0.0.0.0
RAG_PORT=8000
RAG_LOG_LEVEL=info

# Shared secret: the API gateway must send the same value (its RAG_API_KEY)
RAG_API_KEY=
# Browser origins allowed by CORS (normally none; the gateway calls server-to-server)
RAG_CORS_ORIGINS=
